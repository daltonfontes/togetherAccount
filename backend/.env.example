# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=together_account
DB_PASSWORD=together_account
DB_DATABASE=together_account
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-please-use-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-please-use-a-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Google Sign-In (optional — leave unset to disable the /auth/google routes)
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# and add GOOGLE_CALLBACK_URL as an authorized redirect URI there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=together-account-api
LOG_LEVEL=info

# Frontend URL (used for invite links, CORS, emails)
FRONTEND_URL=http://localhost:3000
