# Variables consumed by docker-compose.prod.yml.
# Copy these into Dokploy's environment editor for the Compose service
# (do not commit a filled-in version of this file).

# --- Required: the stack refuses to start without these -------------------

# openssl rand -hex 32 (use a different value for each secret)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Postgres password (any strong random string)
DB_PASSWORD=

# Public URLs of the deployed apps
CORS_ORIGINS=https://app.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1

# --- Optional: sensible defaults already baked into the compose file ------

# DB_USERNAME=together_account
# DB_DATABASE=together_account
# DB_HOST=postgres
# DB_PORT=5432
# DB_SSL=false
# REDIS_HOST=redis
# REDIS_PORT=6379
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d
# THROTTLE_TTL=60
# THROTTLE_LIMIT=100
# LOG_LEVEL=info

# Set to 'false' only if you also add the Tempo/observability stack back in
# OTEL_SDK_DISABLED=true
